{
  "expo": {
    "name": "L'E-Divan",
    "slug": "ledivan-mobile",
    "owner": "reverblabss-team",
    "version": "1.0.0",
    "scheme": "ledivan",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#2b1830"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reverblabs.ledivan"
    },
    "android": {
      "package": "com.reverblabs.ledivan",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2b1830",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sqlite",
      "expo-splash-screen",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usar biometria para desbloquear o app"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8b5cf6"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://maven-central.storage-download.googleapis.com/maven2/"
            ]
          }
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://ledivan.com.br",
      "router": {},
      "eas": {
        "projectId": "04991290-66a4-44cb-a584-64f665c61412"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {}
  }
}